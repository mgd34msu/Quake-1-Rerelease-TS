{
  "name": "quake-1-re-ts",
  "version": "1.0.0",
  "private": true,
  "description": "The 2021 Quake re-release engine in TypeScript on Bun, seeded from Quake-1-TS: classic and re-release content under any ruleset, NetQuake 15/666/999 and QuakeWorld 28, software and OpenGL renderers.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "check": "bash scripts/check.sh",
    "test": "Q1TS_NOHOMEDIR=1 bun test",
    "start": "bun run src/main.ts",
    "start:qwsv": "bun run src/main.ts -dedicated -qw",
    "start:qwcl": "bun run src/main.ts -qw",
    "build": "bun build --compile src/main.ts --outfile q1rets",
    "build:linux-x64": "bash scripts/release-build.sh linux-x64",
    "build:windows-x64": "bash scripts/release-build.sh windows-x64",
    "build:darwin-arm64": "bash scripts/release-build.sh darwin-arm64",
    "build:darwin-x64": "bash scripts/release-build.sh darwin-x64",
    "build:release": "bash scripts/release-build.sh --zip all",
    "build:aliases": "bash scripts/release-build.sh --aliases linux-x64"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
